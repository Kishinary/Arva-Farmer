      CC Duration: High | AoE

      <#FFFF00>400G</color>'
  - itemName: Yen sao
    itemIcon: {fileID: 1403812638501723641, guid: 39c617104796ca74db4b2e550f035cf9, type: 3}
    dropPrefab: {fileID: 8384293969686541230, guid: bbd4c08064c898244b2f868e9e1962ce, type: 3}
    price: 250
    description: 'A premium drink granting a <#00FF00>massive speed boost</color>
