.health-container {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/ThaleahFat.ttf?fileID=12800000&guid=ac750909d96903d4381e41b27407aca1&type=3#ThaleahFat");
}

.hp-text {
    color: white;
    font-size: 35px;
    -unity-font-style: bold;
    text-shadow: 3px 3px 0 black;
    margin-right: 12px;
}

.bar-background {
    width: 145px;
    height: 32px;
    background-color: rgb(26, 26, 26);
    border-width: 3px;
    border-color: black;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    height: 100%;
    width: 100%;
}

.main-color {
    background-color: rgb(230, 57, 57);
    transition-property: width;
    transition-duration: 0.1s;
}

.ghost-color {
    background-color: rgb(255, 140, 0);
    transition-property: width;
    transition-duration: 0.6s;
    transition-delay: 0.3s;
}

.hp-numbers {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: black;
}
