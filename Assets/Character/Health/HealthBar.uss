/* CONTAINER CHÍNH */
.hp-bar-container {
    position: absolute;
    left: 230px;
    top: 175px;
    width: 330px;
    height: 60px;
    flex-direction: row;
    align-items: center;
    /* Đảm bảo không bị văng khi scale */
    right: auto;
    bottom: auto;
}

/* CHỈ SỐ MÁU (100/100) */
.hp-text {
    position: absolute;
    top: -20px;
    left: 25px;
    color: rgb(255, 255, 255);
    font-size: 33px;
    -unity-font-style: bold;
    text-shadow: 1.5px 1.5px 2px rgb(0, 0, 0);
    /* Đường dẫn font pixel của bạn */
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/ThaleahFat.ttf");
}

/* NHÃN CHỮ HP */
.hp-label {
    color: rgb(255, 255, 255);
    font-size: 45px;
    -unity-font-style: bold;
    width: 60px;
    height: 40px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgb(150, 0, 0);
    margin-right: 10px;
}

/* KHUNG CHỨA THANH MÁU */
.hp-bar-stack {
    flex-grow: 1;
    height: 42px;
    position: relative;
}

/* HIỆU ỨNG ĐỔ BÓNG (DƯỚI CÙNG) */
.hp-shadow-drop {
    position: absolute;
    left: 2px;
    top: 2px;
    right: -2px;
    bottom: -2px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.5);
}

/* VIỀN TỐI */
.hp-bevel-dark {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 5px;
    background-color: rgb(20, 15, 10);
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-color: rgb(0, 0, 0);
}

/* VIỀN SÁNG */
.hp-bevel-light {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 4px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    padding: 2px;
}

/* NỀN TRONG */
.hp-bar-inner {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: hidden;
    background-color: rgb(40, 10, 10);
}

/* THANH TRẮNG (GHOST) */
.hp-bar-ghost {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    width: 100%;
    transition-property: width;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-sine;
}

/* THANH ĐỎ CHÍNH */
.hp-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(210, 0, 0);
    width: 100%;
}

/* ÁNH SÁNG TRÊN THANH MÁU */
.hp-fill-highlight {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 40%;
    background-color: rgba(255, 255, 255, 0.25);
}