.full-screen-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    height: auto;
}

.banner-background {
    width: 100%;
    height: 125px;
    background-color: rgba(0, 0, 0, 0.65);
    justify-content: center;
    align-items: center;
    top: auto;
    bottom: 100px;
}

.pixel-text {
    font-size: 70px;
    color: rgb(248, 197, 58);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/ThaleahFat.ttf?fileID=12800000&guid=ac750909d96903d4381e41b27407aca1&type=3#ThaleahFat");
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
    margin-bottom: 5px;
}
