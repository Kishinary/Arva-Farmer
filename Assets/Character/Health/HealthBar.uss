.hp-bar-container {
    flex-direction: row;
    align-items: center;
    width: 210px;
    height: 34px;
}

.hp-label {
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    width: 35px;
    height: 35px;
    text-shadow: 1px 1px 0 rgb(183, 0, 0), -1px -1px 0 rgb(0, 0, 0);
}

.hp-bar-stack {
    flex-grow: 1;
    height: 26px;
    position: relative;
}

.hp-shadow-drop {
    position: absolute;
    left: 2px;
    top: 2px;
    right: -2px;
    bottom: -2px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.6);
}

.hp-bevel-dark {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 5px;
    background-color: rgb(20, 15, 10);
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-color: rgb(0, 0, 0);
}

.hp-bevel-light {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 4px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 2px;
}

.hp-bar-inner {
    width: 100%;
    height: 100%;
    border-radius: 3px;
    overflow: hidden;
    background-color: rgb(30, 10, 10);
    position: relative;
}

.hp-bar-ghost {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(251, 251, 251);
    width: 100%;
}

.hp-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(200, 0, 0);
    width: 100%;
}

.hp-fill-highlight {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 40%;
    background-color: rgba(255, 255, 255, 0.2);
}

.hp-bar-empty {
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.hp-text {
    position: absolute;
    top: -10px;
    left: 60px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px black;
    -unity-font-definition: url("project://database/Assets/Material/Pixel%20Game.otf?fileID=12800000&guid=b45585296b46ff14887a6f4d50d63943&type=3#Pixel Game");
}
