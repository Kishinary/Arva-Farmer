    dropPrefab: {fileID: 8384293969686541230, guid: db4a7676e20dce6408a86f126e6185eb, type: 3}
    price: 150
    description: 'Catch bugs and shoot them! A reliable <#FF8800>ranged weapon</color>
      with fast reloads.

      DMG: 15 | Catch Range: 0.8 | CD: 0.5s

      <#FFFF00>150G</color>'
  - itemName: Rake
    itemIcon: {fileID: 3835505975060019071, guid: f643d299f47bea142a19ec879f31f0d0, type: 3}
    dropPrefab: {fileID: 8384293969686541230, guid: 250cf002b5aae914e87cb19353c149ee, type: 3}
    price: 180
    description: 'Pull enemies in and set <#FF4444>deadly traps</color>. Excellent
      for crowd control.

      Trap Cap: 5 | Pull SPD: 4

      <#FFFF00>180G</color>'
  - itemName: Scissors
    itemIcon: {fileID: -8534046741536091761, guid: 20146001a85e3304990116a73a6c2804, type: 3}
    dropPrefab: {fileID: 8384293969686541230, guid: af2f0df8b48a5ab4eac558c4f72ffbdf, type: 3}
    price: 450
    description: 'Lightning-fast <#FF4444>melee thrusts</color>. Shreds enemies up
      close in the blink of an eye.

      DMG: 25 | CD: 0.05s

      <#FFFF00>450G</color>'
  - itemName: WaterCan
    itemIcon: {fileID: -5253021402717179167, guid: 3efab488fc2fc3848ac079f400fb964e, type: 3}
    dropPrefab: {fileID: 8384293969686541230, guid: 1638516ba78a7a248962ae9f17336471, type: 3}
    price: 350
    description: 'Fires a piercing <#00FFFF>laser beam</color> to easily sweep through
      large swarms.

      DMG: 10/tick | Max Dist: 10

      <#FFFF00>350G</color>'
  - itemName: Boomerang
    itemIcon: {fileID: -8992175993407916659, guid: e74442918725c924fb32f4401a59eac5, type: 3}
    dropPrefab: {fileID: 26655022856714795, guid: 3369ab6d6126fd8469be4e10a30ad599, type: 3}
    price: 300
    description: 'Throws a heavy axe that <#FF8800>returns</color> to you, hitting
      targets twice.

      DMG: 10 | Throw SPD: 20

      <#FFFF00>300G</color>'
  - itemName: tractor
    itemIcon: {fileID: -4571828015118065507, guid: eb9eb96dc626c3847a92e7e6e5afdbcd, type: 3}
    dropPrefab: {fileID: 8384293969686541230, guid: 04afb223ce8eb7b4caf906a59adf535d, type: 3}
    price: 1200
    description: 'Summon a massive tractor to <#FF4444>crush everything</color> in
      its path!

      Burst DMG: 100 | CD: 2s

      <#FFFF00>1200G</color>'
  - itemName: stun
    itemIcon: {fileID: 21300000, guid: ed184a2883902d847a027af94f40c2e6, type: 3}
    dropPrefab: {fileID: 26655022856714795, guid: d6cdaf83ebf06ce45bcfb44c37e7a504, type: 3}
    price: 400
    description: 'Paralyze enemies with a <#00FFFF>shockwave</color>. Perfect for
