.background {
    flex-grow: 1;
    /* Đổi từ center sang flex-start để đẩy nội dung sang bên trái */
    align-items: flex-start; 
    /* Đẩy toàn bộ nội dung xuống dưới */
    justify-content: flex-end; 
    /* Chỉnh khoảng cách lề trái để căn thẳng hàng với Logo */
    padding-left: 95px; 
    padding-bottom: 80px;
    background-color: rgba(0, 0, 0, 0);
}

.menu-container {
    /* Căn chữ lề trái bên trong container */
    align-items: flex-start; 
    justify-content: center;
    padding: 0;
    margin: 0;
}

.menu-item {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/ThaleahFat.ttf?fileID=12800000&guid=ac750909d96903d4381e41b27407aca1&type=3#ThaleahFat");
    font-size: 30px; /* Tăng nhẹ kích thước để dễ đọc */
    -unity-font-style: bold;
    
    /* ĐỔI SANG MÀU VÀNG (giống màu lúa trên logo) */
    color: rgb(255, 215, 130); 
    
    margin-top: 5px;
    margin-bottom: 5px;
    padding: 0;
    /* Shadow đậm hơn một chút để nổi bật trên nền gỗ */
    text-shadow: 2px 2px 0 rgb(40, 20, 0); 
    
    transition-property: scale, color;
    transition-duration: 0.1s;
    transform-origin: left center; /* Zoom từ bên trái sang */
    
    /* Căn chữ text sang trái */
    -unity-text-align: middle-left; 
}

.menu-item:hover {
    /* Màu vàng sáng hơn khi hover */
    color: rgb(255, 255, 200); 
    scale: 1.1 1.1;
}