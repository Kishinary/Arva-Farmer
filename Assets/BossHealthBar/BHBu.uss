/* Container căn giữa mọi thứ */
.health-bar-container {
    position: absolute;
    top: 0px; /* Cách nóc màn hình 50px */
    left: 50%; 
    translate: -50% 0; 
    
    width: 400px;
    height: 60px;
    align-items: center;
    justify-content: center;
}

/* 1. LỚP ĐEN ĐỔ BÓNG TRONG CÙNG */
.bar-black-shadow {
    width: 100%;
    height: 24px; /* Độ dày thanh máu */
    background-color: rgb(0, 0, 0);
    /* Padding tạo thành viền đen. Padding bottom dày hơn tạo hiệu ứng Shadow */
    padding-top: 2px;
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 5px; 
    border-radius: 4px;
}

/* 2. LỚP VIỀN TRẮNG */
.bar-white-border {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    padding: 2px; /* Độ dày của viền trắng */
    border-radius: 2px;
}

/* 3. LỚP NỀN THANH MÁU (MÀU TỐT) */
.bar-track {
    width: 100%;
    height: 100%;
    background-color: rgb(44, 44, 62); /* Màu xanh đen tĩnh */
}

/* 4. LỚP MÁU ĐỎ */
.bar-fill {
    height: 100%;
    width: 45%; /* Code C# sẽ thay đổi chỉ số này (0% - 100%) */
    background-color: rgb(217, 58, 70); /* Màu đỏ ngói */
}

/* --- TEXT TÊN BOSS --- */
.boss-name {
    position: absolute;
    top: 0px; /* Nhô lên trên thanh máu */
    color: rgb(255, 255, 255);
    font-size: 20px;
    /* Cấu hình viền chữ đen chuẩn Pixel Art */
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    /* QUAN TRỌNG: Thêm font Pixel của bạn vào đây để giống 100% */
    /* -unity-font-definition: url('project://database/Assets/Fonts/YourPixelFont.asset'); */
}

